root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

# Captured response bodies compared byte for byte by the functional tests (AC-015).
[src/functionalTest/resources/golden/*.json]
insert_final_newline = false
