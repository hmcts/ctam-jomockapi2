      "name": "Reference Data",
      "item": [
        {
          "name": "GET /api/v1/reference_data/appointment_titles - success",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reference_data/appointment_titles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reference_data", "appointment_titles"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('results is an array of 194 records', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(Object.keys(body)).to.eql(['results']);",
                  "    pm.expect(body.results).to.be.an('array').with.lengthOf(194);",
                  "});",
                  "",
                  "pm.test('Each record has exactly the six contract fields', function () {",
                  "    const expected = ['id', 'name', 'created_at', 'updated_at', 'start_date', 'end_date'];",
                  "    pm.response.json().results.forEach(function (record) {",
                  "        pm.expect(Object.keys(record)).to.eql(expected);",
                  "    });",
                  "});",
                  "",
                  "pm.test('ids are in ascending order', function () {",
                  "    const ids = pm.response.json().results.map(function (record) { return record.id; });",
                  "    for (let i = 1; i < ids.length; i++) {",
                  "        pm.expect(ids[i]).to.be.above(ids[i - 1]);",
                  "    }",
                  "});",
                  "",
                  "pm.test('X-Correlation-Id response header is present', function () {",
                  "    pm.response.to.have.header('X-Correlation-Id');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
