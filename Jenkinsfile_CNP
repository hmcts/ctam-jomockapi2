#!groovy

// The HMCTS shared Java pipeline (specs/014-jenkins-preview-deployment).
//
// Only pull requests are built, checked and deployed, to the preview environment: the library treats only a branch
// named `master` as a route to live (AAT, then production), and this repository's default branch is `main`, where
// Jenkins does nothing and GitHub Actions is the gate (014 research R-2; AAT and beyond are deferred item DF-12).
//
// After deploying, the pipeline sets TEST_URL to the preview address and runs `./gradlew smoke` and then
// `./gradlew functional`. The preview release is removed at the end of the run unless the pull request is labelled
// `enable_keep_helm`.

@Library("Infrastructure@2.13.5") _

def type = "java"
def product = "ctam"
def component = "jomockapi"

// The bearer token the preview copy accepts, defined once here (014 FR-003, FR-012; amended 2026-11-23). The library
// substitutes it into charts/ctam-jomockapi/values.preview.template.yaml with envsubst, so the deployed copy and the
// smoke and functional tests always share one value. Preview uses no Key Vault: a preview copy serves only synthetic
// data, is reachable only on HMCTS's internal preview network, and is removed after each run. It must never be
// local-dev-token or test-token (the smoke test checks that local-dev-token is refused). Shared environments will
// hold their tokens in Key Vault instead (DF-12).
env.TEST_BEARER_TOKEN = 'ctam-preview-token'

withPipeline(type, product, component) {
}
